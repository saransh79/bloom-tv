# Razorpay Subscriptions test mode. Obtain these from the Razorpay Dashboard.
# Never put the secret values in NEXT_PUBLIC_ variables or commit .env.local.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_secret
# Create a plan for INR 699.00, quarterly interval 1, then copy its plan ID.
RAZORPAY_PLAN_ID=plan_replace_me
# Number of quarterly charges to authorize; decide this before collecting consent.
RAZORPAY_TOTAL_COUNT=10
# Generate a random value of at least 32 characters.
RAZORPAY_COOKIE_SECRET=replace_with_a_random_value_at_least_32_characters

# Set before launch so customers have a direct support path.
SUPPORT_EMAIL=replace_with_support_email
